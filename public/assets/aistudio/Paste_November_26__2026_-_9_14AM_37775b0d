        function filterJobs() {
            const kw = document.getElementById('job-filter-keyword').value.toLowerCase().trim();
            const ind = document.getElementById('job-filter-industry').value;
            const lvl = document.getElementById('job-filter-level').value;
            const loc = document.getElementById('job-filter-location').value;

            const filtered = jobsData.filter(j => {
                const matchKw = !kw || j.title.toLowerCase().includes(kw) || j.desc.toLowerCase().includes(kw) || j.industry.toLowerCase().includes(kw);
                const matchInd = ind === 'all' || j.industry === ind;
                const matchLvl = lvl === 'all' || j.level === lvl;
                const matchLoc = loc === 'all' || j.location === loc;
                return matchKw && matchInd && matchLvl && matchLoc;
            });

            renderJobs(filtered);
        }

        function resetJobFilters() {
            document.getElementById('job-filter-keyword').value = '';
            document.getElementById('job-filter-industry').value = 'all';
            document.getElementById('job-filter-level').value = 'all';
            document.getElementById('job-filter-location').value = 'all';
            renderJobs(jobsData);
        }

