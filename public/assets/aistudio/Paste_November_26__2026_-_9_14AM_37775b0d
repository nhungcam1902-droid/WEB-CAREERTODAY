        function runGlobalSearch(query) {
            const box = document.getElementById('global-search-results');
            const q = query.toLowerCase().trim();
            if (!q) {
                box.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">Nhập từ khóa để tìm kiếm nhanh trong Việc làm, Dịch vụ và Tin tức...</p>`;
                return;
            }

            const matchedJobs = jobsData.filter(j => j.title.toLowerCase().includes(q) || j.location.toLowerCase().includes(q) || j.industry.toLowerCase().includes(q));
            const matchedNews = newsData.filter(n => n.title.toLowerCase().includes(q) || n.summary.toLowerCase().includes(q));

            let html = '';
            matchedJobs.forEach(j => {
                html += `
                    <div onclick="closeModal('search-modal'); openJobDetail(${j.id})" class="p-3 rounded-xl hover:bg-blue-50 border border-gray-100 cursor-pointer flex items-center justify-between gap-3">
                        <div>
                            <span class="text-[10px] font-extrabold uppercase text-brandRed bg-red-50 px-2 py-0.5 rounded">VIỆC LÀM</span>
                            <div class="font-bold text-slate-900 mt-1">${j.title}</div>
                            <div class="text-xs text-slate-500">${j.location} • ${j.salary}</div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-slate-400"></i>
                    </div>`;
            });
            matchedNews.forEach(n => {
                html += `
                    <div onclick="closeModal('search-modal'); openNewsDetail(${n.id})" class="p-3 rounded-xl hover:bg-blue-50 border border-gray-100 cursor-pointer flex items-center justify-between gap-3">
                        <div>
                            <span class="text-[10px] font-extrabold uppercase text-brandBlue bg-blue-50 px-2 py-0.5 rounded">TIN TỨC</span>
                            <div class="font-bold text-slate-900 mt-1">${n.title}</div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-slate-400"></i>
                    </div>`;
            });

            if (!html) {
                html = `<p class="text-xs text-slate-500 text-center py-6">Không tìm thấy kết quả phù hợp cho "<strong>${query}</strong>".</p>`;
            }
            box.innerHTML = html;
        }

        // BILINGUAL SWITCHER VI | EN
        function switchLang(lang) {
            currentLang = lang;
            const viBtn = document.getElementById('btn-vi');
            const enBtn = document.getElementById('btn-en');
            if (lang === 'vi') {
                viBtn.className = 'px-2.5 py-1 rounded-full text-xs font-extrabold bg-brandBlue text-white shadow-xs transition';
                enBtn.className = 'px-2.5 py-1 rounded-full text-xs font-extrabold text-slate-600 hover:text-brandBlue transition';
            } else {
                enBtn.className = 'px-2.5 py-1 rounded-full text-xs font-extrabold bg-brandBlue text-white shadow-xs transition';
                viBtn.className = 'px-2.5 py-1 rounded-full text-xs font-extrabold text-slate-600 hover:text-brandBlue transition';
            }

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18nDict[lang][key]) {
                    el.textContent = i18nDict[lang][key];
                }
            });

            renderClientSectors(clientSectors);
            renderJobs(jobsData);
            renderNews(newsData);
            showToast(lang === 'vi' ? 'Đã chuyển sang Tiếng Việt' : 'Switched to English');
        }

        // HELPERS
        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function showToast(msg) {
            const box = document.getElementById('toast-box');
            const el = document.createElement('div');
            el.className = 'bg-slate-900 text-white border-l-4 border-brandRed px-4 py-3 rounded-xl shadow-xl text-xs sm:text-sm font-semibold flex items-center gap-2.5 pointer-events-auto transition-all';
            el.innerHTML = `<i class="fa-solid fa-circle-check text-brandRed"></i><span>${msg}</span>`;
            box.appendChild(el);
            setTimeout(() => {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            }, 3200);
        }
    </script>
</body>
</html>